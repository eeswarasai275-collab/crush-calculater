<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>A Special Question for You 💖</title>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      min-height: 100vh;
      background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #feada6 100%);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      overflow-x: hidden;
      position: relative;
    }

    /* Floating Hearts Background */
    .bg-heart {
      position: absolute;
      color: rgba(255, 255, 255, 0.4);
      animation: floatUp 8s infinite linear;
      pointer-events: none;
      z-index: 1;
    }

    @keyframes floatUp {
      0% {
        transform: translateY(100vh) scale(0.5);
        opacity: 0;
      }
      50% {
        opacity: 0.8;
      }
      100% {
        transform: translateY(-10vh) scale(1.2);
        opacity: 0;
      }
    }

    /* Main Card */
    .card {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(10px);
      border-radius: 24px;
      padding: 30px;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 15px 35px rgba(255, 105, 180, 0.2);
      border: 2px solid rgba(255, 255, 255, 0.6);
      text-align: center;
      position: relative;
      z-index: 10;
    }

    .card h1 {
      color: #ff477e;
      font-size: 1.8rem;
      margin-bottom: 10px;
    }

    .card p {
      color: #666;
      font-size: 0.95rem;
      margin-bottom: 25px;
    }

    .input-group {
      margin-bottom: 18px;
      text-align: left;
    }

    .input-group label {
      display: block;
      color: #ff477e;
      font-weight: 600;
      font-size: 0.85rem;
      margin-bottom: 6px;
    }

    .input-group input, .input-group textarea {
      width: 100%;
      padding: 12px 16px;
      border: 2px solid #ffccd5;
      border-radius: 12px;
      outline: none;
      font-size: 0.95rem;
      transition: all 0.3s ease;
      background: rgba(255, 255, 255, 0.9);
    }

    .input-group input:focus, .input-group textarea:focus {
      border-color: #ff477e;
      box-shadow: 0 0 8px rgba(255, 71, 126, 0.3);
    }

    .btn-submit {
      width: 100%;
      background: linear-gradient(45deg, #ff477e, #ff70a6);
      color: white;
      border: none;
      padding: 14px;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 5px 15px rgba(255, 71, 126, 0.4);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-submit:active {
      transform: scale(0.98);
    }

    /* Secret Trigger Corner */
    #vault-trigger {
      position: fixed;
      bottom: 0;
      right: 0;
      width: 50px;
      height: 50px;
      z-index: 999;
      cursor: default;
    }

    /* Admin Modal */
    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(5px);
      z-index: 1000;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .modal-content {
      background: white;
      border-radius: 20px;
      padding: 25px;
      width: 100%;
      max-width: 400px;
      text-align: center;
    }

    .modal-content h2 {
      color: #ff477e;
      margin-bottom: 15px;
    }

    .close-btn {
      margin-top: 15px;
      background: #eee;
      border: none;
      padding: 8px 16px;
      border-radius: 8px;
      cursor: pointer;
    }
  </style>
</head>
<body>

  <!-- Floating Hearts Animation -->
  <div id="hearts-container"></div>

  <!-- Prank Form Card -->
  <div class="card" id="form-card">
    <h1>Secret Crush Confession 💌</h1>
    <p>Fill in the details below to unlock your special compatibility score!</p>

    <form id="crush-form">
      <div class="input-group">
        <label for="name">Your Name</label>
        <input type="text" id="name" required placeholder="Enter your full name">
      </div>

      <div class="input-group">
        <label for="crush">Your Crush's Name</label>
        <input type="text" id="crush" required placeholder="Who's on your mind?">
      </div>

      <div class="input-group">
        <label for="message">Secret Message</label>
        <textarea id="message" rows="3" placeholder="Write something cute..."></textarea>
      </div>

      <button type="submit" class="btn-submit" id="submit-btn">Calculate Compatibility ✨</button>
    </form>
  </div>

  <!-- Success Screen Card -->
  <div class="card" id="success-card" style="display: none;">
    <h1>100% Match! 💖</h1>
    <p>Your confession has been saved in the stars ✨</p>
  </div>

  <!-- Invisible Trigger for Admin Vault -->
  <div id="vault-trigger"></div>

  <!-- Admin Vault Modal -->
  <div class="modal" id="admin-modal">
    <div class="modal-content">
      <h2>🔒 Admin Vault</h2>
      <p id="vault-status">Accessing encrypted database...</p>
      <button class="close-btn" onclick="closeVault()">Close</button>
    </div>
  </div>

  <script>
    // Create Background Hearts
    const heartsContainer = document.getElementById('hearts-container');
    const heartSymbols = ['💖', '💗', '🌸', '✨', '💕'];
    for (let i = 0; i < 20; i++) {
      const heart = document.createElement('div');
      heart.className = 'bg-heart';
      heart.innerText = heartSymbols[Math.floor(Math.random() * heartSymbols.length)];
      heart.style.left = Math.random() * 100 + 'vw';
      heart.style.animationDuration = (Math.random() * 5 + 5) + 's';
      heart.style.animationDelay = Math.random() * 5 + 's';
      heart.style.fontSize = (Math.random() * 20 + 15) + 'px';
      heartsContainer.appendChild(heart);
    }

    // Form Submission Logic
    const form = document.getElementById('crush-form');
    const SCRIPT_URL = "YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL"; // PASTE YOUR WEB APP URL HERE

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submit-btn');
      submitBtn.innerText = "Processing...";
      submitBtn.disabled = true;

      const payload = {
        name: document.getElementById('name').value,
        crush: document.getElementById('crush').value,
        message: document.getElementById('message').value
      };

      try {
        await fetch(SCRIPT_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        // Trigger Confetti
        confetti({
          particleCount: 100,
          spread: 70,
          origin: { y: 0.6 }
        });

        document.getElementById('form-card').style.display = 'none';
        document.getElementById('success-card').style.display = 'block';
      } catch (err) {
        alert("Oops! Something went wrong. Try again.");
        submitBtn.innerText = "Calculate Compatibility ✨";
        submitBtn.disabled = false;
      }
    });

    // Admin Vault Mechanics (Triple Tap Bottom Right)
    let tapCount = 0;
    let tapTimer;
    const trigger = document.getElementById('vault-trigger');

    trigger.addEventListener('click', () => {
      tapCount++;
      clearTimeout(tapTimer);
      tapTimer = setTimeout(() => { tapCount = 0; }, 1000);

      if (tapCount >= 3) {
        tapCount = 0;
        openVault();
      }
    });

    // Shortcut for Desktop (Ctrl + Shift + E)
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey && e.shiftKey && e.key.toLowerCase() === 'e') {
        openVault();
      }
    });

    function openVault() {
      const pwd = prompt("Enter Admin Password:");
      if (pwd === "sai275275") {
        document.getElementById('admin-modal').style.display = 'flex';
      } else if (pwd !== null) {
        alert("Access Denied! Invalid Password.");
      }
    }

    function closeVault() {
      document.getElementById('admin-modal').style.display = 'none';
    }
  </script>
</body>
</html>
